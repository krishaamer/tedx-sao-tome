/*******************************
     User Global Variables
*******************************/

@importGoogleFonts: false;
@fontName: "ITCFranklinGothic";
@headerFont: "ITCFranklinGothic";
@pageFont: "ITCFranklinGothic";
@emSize: 16px;
@fontSize: 16px;

@defaultBorderRadius: 0;
@absoluteBorderRadius: 0;

@green: #00d2a0;
@grey: #eaeaea;
@black: #000000;

@h1: 5.625rem;
@h2: 1.375rem;
@h3: 1.375rem;
@h4: 1rem;
@h5: 1rem;
@h6: 1rem;

@textColor: @black;
@linkColor: @black;
@linkUnderline: none;
@linkHoverUnderline: underline;
@linkHoverColor: @black;
