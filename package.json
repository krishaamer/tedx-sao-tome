{
  "name": "tedx-sao-tome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev:web": "pnpm --filter @tedxsaotome/web dev",
    "lint": "pnpm --filter @tedxsaotome/web lint",
    "build": "pnpm --filter @tedxsaotome/web build",
    "check": "pnpm lint && pnpm verify:design-system && pnpm build && pnpm verify:export",
    "verify:design-system": "node --test tools/validation/design-system-parser.test.mjs && node tools/validation/verify-design-system.mjs",
    "verify:export": "node tools/validation/verify-static-export.mjs"
  },
  "devDependencies": {
    "postcss": "8.4.31"
  }
}
